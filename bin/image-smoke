#!/usr/bin/env bash
# Smoke-tests a built Collector image (spec 012, AC-6.1 to AC-6.4): boots it, checks the pages and files it must
# serve, runs the operational rake tasks, then checks that /rails/vendor holds nothing unexpected and that
# development-only paths and secrets are absent, that it reports its version and revision (spec 084), and that the
# licence page (spec 087) renders before any user exists, lists the image's own bundle and engine with a gem's licence
# file under its own name and no development gem, and is linked from the sign-in page's licence line.
#
#   bin/image-smoke <image> [extra `run` flags, e.g. --platform linux/arm64]
#
# Uses docker when present, else podman (override with CONTAINER_CLI). Exit status 0 means every check passed.
set -euo pipefail

image="${1:?usage: bin/image-smoke <image> [run flags]}"
shift
run_flags=("$@")
cli="${CONTAINER_CLI:-$(command -v docker >/dev/null 2>&1 && echo docker || echo podman)}"
name="collector-smoke-$$"
attempts="${SMOKE_BOOT_ATTEMPTS:-60}" # 2 s each; raise it for emulated runs

cleanup() { "$cli" rm -f "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
fail() { echo "FAIL: $*" >&2; exit 1; }
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
status() { curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${port}$1"; }

echo "== boot ${image}"
# ${a[@]+"${a[@]}"}: bash 3.2 (macOS's /bin/bash) calls an empty array unbound under set -u.
"$cli" run -d --name "$name" ${run_flags[@]+"${run_flags[@]}"} -p 127.0.0.1::8080 \
  -e SECRET_KEY_BASE=smoke-only-not-a-secret -e HTTP_PORT=8080 -e SOLID_QUEUE_IN_PUMA=true "$image" >/dev/null
ports="$("$cli" port "$name" 8080)" # captured first, then cut: no pipe into an early-exiting reader under pipefail (#217)
port="${ports%%$'\n'*}"
port="${port##*:}"
for _ in $(seq 1 "$attempts"); do
  [ "$(status /up)" = "200" ] && break
  sleep 2
done
[ "$(status /up)" = "200" ] || { "$cli" logs "$name" >&2; fail "/up did not answer 200 within $((attempts * 2)) s"; }

echo "== first run"
[ "$(status /registration/new)" = "200" ] || fail "first-run registration page did not render"
[ "$(status /licences)" = "200" ] || fail "the licence page did not render before any user exists"

echo "== operational tasks"
# Each task's output is captured first, then tested, so no pipe can end early under pipefail. A fresh instance's
# catalog:status prints its line and then the source's own lines (the art line, spec 011), so the line is matched
# whole, not the output.
catalog_status="$("$cli" exec "$name" bin/rails "catalog:status[mtg]" 2>&1)" || fail "catalog:status[mtg] exited $?:"$'\n'"$catalog_status"
grep -qxF "No mtg refresh runs yet." <<<"$catalog_status" \
  || fail "catalog:status[mtg] did not print the line 'No mtg refresh runs yet.' (AC-6.3); it printed:"$'\n'"$catalog_status"
user_task="$("$cli" exec -e COLLECTOR_PASSWORD=smoke-password-1234 "$name" bin/rails "collector:user[smoke@example.com]" 2>&1)" \
  || fail "collector:user exited $?:"$'\n'"$user_task"
grep -qxF "Created admin smoke@example.com." <<<"$user_task" \
  || fail "collector:user did not print the line 'Created admin smoke@example.com.' (AC-6.3); it printed:"$'\n'"$user_task"

echo "== Active Storage variants use libvips (spec 014)"
vips="$("$cli" exec "$name" bin/rails runner 'puts ActiveStorage.variant_transformer' 2>&1)" || fail "vips: bin/rails runner exited $?:"$'\n'"$vips"
if grep -qE "requires the (ruby-vips gem|libvips library)" <<<"$vips" || ! grep -qx "ActiveStorage::Transformers::Vips" <<<"$vips"; then
  fail "vips: variants can't use libvips:"$'\n'"$vips"
fi

echo "== pages and assets (a user exists now, so first-run redirects are over)"
[ "$(status /session/new)" = "200" ] || fail "sign-in page did not render"
[ "$(status /scanner)" = "302" ] || fail "/scanner should redirect to sign-in when signed out"
[ "$(status /ocr/v7.0.0/tesseract.min.js)" = "200" ] || fail "OCR engine is not served"
[ "$(status /ocr/v7.0.0/lang/eng.traineddata.gz)" = "200" ] || fail "OCR language data is not served"

# The image's build passes its facts as build arguments (spec 084 decision 3); an image without them shows "unknown
# version" and is never published. Only the two named variables are read, captured and then tested (no pipe).
echo "== the build facts (spec 084)"
build_args="build it with --build-arg COLLECTOR_VERSION=<version> --build-arg COLLECTOR_REVISION=<40-character SHA> --build-arg COLLECTOR_SOURCE_URL=<https address of the source> (README.md, Building from source)"
version="$(trim "$("$cli" exec "$name" printenv COLLECTOR_VERSION 2>/dev/null || true)")"
revision="$(trim "$("$cli" exec "$name" printenv COLLECTOR_REVISION 2>/dev/null || true)")"
[ -n "$version" ] || fail "the image reports no version: ${build_args}"
grep -qxE '[0-9A-Fa-f]{40}' <<<"$revision" || fail "the image reports no 40-character revision (got '${revision}'): ${build_args}"
short="$(tr 'A-F' 'a-f' <<<"${revision:0:7}")"
sign_in="$(curl -s "http://127.0.0.1:${port}/session/new")" || fail "the sign-in page did not load"
grep -qF "Collector ${version} (${short}) is free software" <<<"$sign_in" \
  || fail "the sign-in page's licence line doesn't read 'Collector ${version} (${short})'"
grep -qF 'href="/licences"' <<<"$sign_in" || fail "the sign-in page's licence line doesn't link /licences (spec 087)"

# The page that lists the third-party licences (spec 087): the image's own bundle, engine, JavaScript and licence texts,
# not the repository's. Captured, then tested (no pipe).
echo "== the third-party licences page (spec 087)"
licences="$(curl -s "http://127.0.0.1:${port}/licences")" || fail "the licence page did not load"
for want in 'Third-party licences' 'c-licences__name">tesseract.js<' 'c-licences__name">turbo-rails<' 'c-licences__file">MIT-LICENSE<'; do
  grep -qF "$want" <<<"$licences" || fail "the licence page lacks: ${want}"
done
if grep -qF 'c-licences__name">yard<' <<<"$licences"; then fail "the licence page lists yard, a development gem the image leaves out"; fi

# Rejects extras only: an empty listing passes. That ocr is there is shown by the OCR files served above.
echo "== nothing unexpected in /rails/vendor: at most .keep, javascript and ocr (issue #31)"
vendor="$("$cli" exec "$name" sh -c 'ls -A /rails/vendor' 2>&1)" || fail "vendor: listing /rails/vendor exited $?:"$'\n'"$vendor"
stray="$(grep -vxE '\.keep|javascript|ocr' <<<"$vendor" || true)"
[ -z "$stray" ] || fail "unexpected in /rails/vendor:"$'\n'"$stray"

echo "== development-only paths and secrets must be absent"
present="$("$cli" exec "$name" sh -c '
  cd /rails
  for path in docs spikes spec script .claude CLAUDE.md .githooks orca.yaml .worktreeinclude config/master.key .kamal bin/ghcr-cleanup lib/collector/ghcr_cleanup.rb bin/backup-smoke bin/upgrade-smoke bin/ci config/ci.rb lib/collector/ci_groups.rb lib/collector/ci_shard.rb lib/collector/push_scope.rb doc .yardoc .yardopts bin/yard; do
    [ -e "$path" ] && echo "$path"
  done
  ls -d .env* 2>/dev/null
  exit 0')"
[ -z "$present" ] || fail "present in the image:"$'\n'"$present"

echo "OK: ${image} passed the smoke test"
