<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Collector" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Collector">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# A page may ask for another refresh method (number entry asks for replace, so autofocus works; spec 026). %>
    <%= turbo_refreshes_with method: content_for(:turbo_refresh_method).presence&.to_sym || :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="icon" href="<%= asset_path("collector/collector-mark.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "collector/tokens", "collector/components", "collector/additions", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Every shell is footed: the footer always holds at least the licence line (spec 084 decisions 1 and 11). A page with no tab
      bar (a visitor's catalog page, sign-in, sign-up) gives up the bar's clearance (spec 023). A focused page
      (`content_for :focused`) is one screen with its own back arrow and live regions: no header, no status line and no footer,
      since its sheets carry the small print in their foot, which is how it meets spec 084's footer on every page (spec 080
      decision 8, spec 082 decisions 6 and 16). %>
  <% focused = content_for?(:focused) %>
  <body class="<%= class_names("c-shell", "c-shell--footed": !focused, "c-shell--untabbed": !content_for?(:tabbar), "c-shell--focused": focused) %>">
    <%= yield :appbar %>
    <% unless focused %><div id="status" class="c-status" role="status" aria-live="polite"><% if (message = flash[:alert] || flash[:notice]) %><%= render "shared/status_message", message:, alert: flash[:alert].present?, undo: (flash[:undo] unless flash[:alert]) %><% end %></div><% end %>
    <%= yield %>
    <% unless focused %><%= render "layouts/footer" %><% end %>
    <%= yield :tabbar %>
  </body>
</html>
