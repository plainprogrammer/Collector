<%# locals: (condition:, location_id:, conditions:, choices:, focus: nil) %>
<%# The sitting's one control (spec 042 decision 2, spec 040 decision 3): native selects and "Set" in one form, grouped under a
    legend, in the destination sheet (spec 082 decision 9), answered by a Turbo Stream that redraws it, so it works by keyboard and without script (AC-7.1; a small
    controller only puts focus back on "Set" after the redraw, spec 047, from the sheet's `sitting_focus_data`). The
    fieldset is the choice page's c-choices (a flex column, no border): the two fields stack, as spec 040's did. %>
<%= tag.div id: "scanner_picker", data: sitting_focus_data(focus) do %>
  <%= form_with url: scanner_sitting_path, method: :patch, scope: :sitting, class: "c-form c-scanner__place" do |form| %>
    <fieldset class="c-choices">
      <legend class="c-field__label">This sitting's cards</legend>
      <div class="c-field">
        <%= form.label :condition, "Condition", class: "c-field__label" %>
        <%= form.select :condition, options_for_select([ [ "Not specified", "" ], *conditions.map { |key, (label, short)| [ "#{label} (#{short})", key ] } ], condition.to_s) %>
      </div>
      <% if choices.any? %>
        <div class="c-field">
          <%= form.label :location_id, "Location", class: "c-field__label" %>
          <%= form.select :location_id, location_options(choices, selected: location_id.to_s, leading: [ [ "No location", "" ] ]) %>
        </div>
      <% end %>
    </fieldset>
    <div class="c-form__actions"><%= form.submit "Set", class: "c-btn c-btn--secondary c-btn--sm", data: { sitting_focus_target: "set" } %></div>
  <% end %>
<% end %>
