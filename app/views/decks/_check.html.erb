<section class="c-deckcheck" aria-labelledby="deck-check-title">
  <h2 class="c-section__title c-deckcheck__title" id="deck-check-title" tabindex="-1" autofocus>Deck check</h2>
  <p class="c-deckcheck__summary"><%= check.summary %></p>
  <ul class="c-deckcheck__list">
    <% check.lines.each do |line| %>
      <li class="c-deckcheck__row<%= line.status ? (line.fault ? " c-deckcheck__row--fault" : " c-deckcheck__row--pass") : " c-deckcheck__row--plain" %>">
        <% if line.status %>
          <span class="c-deckcheck__status"><%= render(line.fault ? "icons/alert" : "icons/check") %><%= line.status %></span>
        <% end %>
        <span class="c-deckcheck__text"><%= line.sentence %></span>
      </li>
    <% end %>
  </ul>
</section>
