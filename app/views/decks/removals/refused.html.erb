<% content_for :title, "Remove deck · Collector" %>
<%= render "layouts/appbar", section: :decks, detail: true, back_path: decks_path %>
<main class="c-main c-page c-decks">
  <section class="c-confirm">
    <h1 class="c-pagehead__title">“<%= @deck.name %>” isn't empty</h1>
    <p>“<%= @deck.name %>” holds <%= location_holds(@holdings.total) %>. Move them before removing it.</p>
    <ul class="c-list c-locations__lots" id="held_lots">
      <% @holdings.listed.each do |lot| %>
        <li>
          <span><%= link_to lot.entry.name, catalog_entry_path(lot.entry, from: "collection", anchor: "copies") %> <span class="c-list__meta c-decks__zone"><%= lot.place_label %></span> <span class="c-list__meta"><%= lot_line(lot) %></span></span>
          <span class="c-list__end">×<%= number_with_delimiter(lot.quantity) %></span>
        </li>
      <% end %>
    </ul>
    <% if @holdings.more.positive? %><p class="c-locations__more">and <%= number_with_delimiter(@holdings.more) %> more</p><% end %>
    <div class="c-form__actions">
      <%= link_to "Back to decks", decks_path, class: "c-btn c-btn--secondary" %>
    </div>
  </section>
</main>
<%= render "layouts/tabbar", section: :decks %>
