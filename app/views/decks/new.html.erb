<% content_for :title, "New deck · Collector" %>
<%= render "layouts/appbar", section: :decks, detail: true, back_path: decks_path %>
<main class="c-main c-page c-decks">
  <div class="c-pagehead">
    <div><h1 class="c-pagehead__title">New deck</h1></div>
  </div>
  <% name_messages = @creation.errors.messages_for(:name) %>
  <% format_messages = @creation.errors.messages_for(:format) %>
  <%= form_with model: @creation, scope: :deck, url: decks_path, class: "c-form" do |form| %>
    <div class="c-field<%= " c-field--invalid" if name_messages.any? %>">
      <%= form.label :name, "Name", class: "c-field__label" %>
      <label class="c-input"><%= form.text_field :name, value: @creation.typed, autocomplete: "off", "aria-describedby": field_error_describedby("deck_name-error", name_messages) %></label>
      <%= render "shared/field_errors", messages: name_messages, id: "deck_name-error" %>
    </div>
    <div class="c-field<%= " c-field--invalid" if format_messages.any? %>">
      <%= form.label :format, "Format", class: "c-field__label" %>
      <%= form.select :format, deck_format_options(@creation.format), {}, "aria-describedby": field_error_describedby("deck_format-error", format_messages) %>
      <%= render "shared/field_errors", messages: format_messages, id: "deck_format-error" %>
      <p class="c-field__hint">The format sets the deck's zones.</p>
    </div>
    <div class="c-form__actions">
      <%= form.submit "Create deck", class: "c-btn c-btn--primary" %>
      <%= link_to "Cancel", decks_path, class: "c-btn c-btn--secondary" %>
    </div>
  <% end %>
</main>
<%= render "layouts/tabbar", section: :decks %>
