# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore the gems a CI runner installs into the checkout (ruby/setup-ruby's bundler-cache, spec 031), so the image pushed
# by digest has the context the smoke-tested one had.
/vendor/bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Ignore development-only files: documentation, spikes, the test suite, research scripts and agent/worktree
# configuration. The published image is public (spec 012), so it carries only what it runs.
/docs
/spikes
/spec
/script
/.claude
/CLAUDE.md
/.githooks
/orca.yaml
/.worktreeinclude

# The OCR engine a set-up checkout holds (bin/setup). The build runs bin/fetch-ocr-engine, so the image always gets
# the copy it downloads and checksum-verifies itself, and a local build matches a CI build (issue #31).
/vendor/ocr

# The GHCR cleanup command runs only in its workflow and locally (spec 013).
/bin/ghcr-cleanup
/bin/backup-smoke
/bin/upgrade-smoke
/lib/collector/ghcr_cleanup.rb

# The CI tooling: bin/ci and its groups and shards run only on a checkout and in CI (spec 035); nothing in the image
# runs them.
/bin/ci
/config/ci.rb
/lib/collector/ci_groups.rb
/lib/collector/ci_shard.rb
/lib/collector/push_scope.rb
