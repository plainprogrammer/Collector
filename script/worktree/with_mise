#!/bin/sh
# Runs a command through `mise exec --`, so it gets the tool versions the checkout names (.ruby-version),
# even where mise isn't on the PATH.
#
#   script/worktree/with_mise [--optional] COMMAND [ARGS...]
#
# Why this exists (#268, after #225): Orca runs a new worktree's setup in a login `bash` that inherits the Orca
# app's PATH (/usr/bin:/bin:/usr/sbin:/sbin). Nothing there activates mise (Homebrew's mise lives in
# /opt/homebrew/bin, off that PATH), so a bare `mise exec` fails with "command not found", and git's
# post-checkout hook, seeing no mise, ran bin/setup on macOS's system Ruby 2.6 ("Could not find 'bundler'").
# So look for mise in the PATH first, then in the places it is installed.
#
# The second half of #268: the setup terminal is a zsh with mise active, and the `bash -lc` started in it
# keeps mise's tool directories in the PATH but moves /usr/bin ahead of them (macOS's path_helper). `mise exec`
# doesn't move a directory that is already in the PATH, so `bin/setup`'s `#!/usr/bin/env ruby` and its
# `bundle` ran on /usr/bin's Ruby 2.6 even through mise. Before `mise exec`, drop mise's own install and shim
# directories from the PATH, so it puts the right ones first.
#
# COLLECTOR_MISE_SEARCH: colon-separated directories to look in after the PATH (default below; tests set it).
# --optional: with no mise anywhere, run COMMAND as it is (CI runners and containers have no mise, and their
# Ruby is already the right one). Without it, no mise is an error (exit 127): Orca's setup must not
# fall back to the system Ruby.
# Exits with COMMAND's status.
optional=false
if [ "$1" = "--optional" ]; then
  optional=true
  shift
fi

search="${COLLECTOR_MISE_SEARCH:-$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.cargo/bin}"

mise=$(command -v mise 2>/dev/null)
case "$mise" in /*) ;; *) mise="" ;; esac # a shell function or alias isn't a binary

if [ -z "$mise" ]; then
  old_ifs=$IFS
  IFS=:
  for dir in $search; do
    if [ -x "$dir/mise" ]; then
      mise="$dir/mise"
      break
    fi
  done
  IFS=$old_ifs
fi

if [ -n "$mise" ]; then
  data="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
  clean=""
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    case "$dir" in
      "$data"/installs/* | "$data"/shims) ;;
      *) clean="${clean:+$clean:}$dir" ;;
    esac
  done
  IFS=$old_ifs
  PATH="$clean"
  export PATH
  exec "$mise" exec -- "$@"
elif $optional; then
  exec "$@"
else
  echo "mise not found on the PATH or in: $search" >&2
  echo "Install mise (https://mise.jdx.dev) or set COLLECTOR_MISE_SEARCH to the directory that has it." >&2
  exit 127
fi
